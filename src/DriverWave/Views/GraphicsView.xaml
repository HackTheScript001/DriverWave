<UserControl x:Class="DriverWave.Views.GraphicsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="24,18,24,8">
      <TextBlock Text="Graphics card" Style="{StaticResource PageTitle}"/>
      <TextBlock Style="{StaticResource PageSub}"
                 Text="Gets the latest driver straight from NVIDIA, AMD or Intel. These are newer than Windows Update's and better for gaming and video work."/>
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,6">
      <StackPanel>
        <TextBlock x:Name="EmptyText" Foreground="{StaticResource Grey}" FontSize="15" Margin="0,30" HorizontalAlignment="Center"
                   Text="Looking for graphics cards…"/>
        <ItemsControl x:Name="GpuList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,16">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" MinWidth="220">
                    <Button Content="{Binding ActionText}" Style="{StaticResource PrimaryButton}" Click="OnAction"
                            IsEnabled="{Binding CanAct}" HorizontalAlignment="Right"/>
                    <Button Content="Open manufacturer's page" Style="{StaticResource GhostButton}" Click="OnOpenPage"
                            HorizontalAlignment="Right" Margin="8,8,0,0" Padding="12,6"/>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="{Binding VendorText}" Foreground="{StaticResource Grey}" FontSize="11.5" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,6"/>
                    <TextBlock Text="{Binding InstalledText}" Foreground="{StaticResource Ink}"/>
                    <TextBlock Text="{Binding LatestText}" Foreground="{StaticResource Ink}" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource Blue}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <ProgressBar Value="{Binding Progress}" IsIndeterminate="{Binding Indeterminate}" Maximum="1" Height="6" Margin="0,8,0,0" MaxWidth="420" HorizontalAlignment="Left" Width="420"
                                 Foreground="{StaticResource Blue}" Background="{StaticResource Line}" BorderThickness="0"
                                 Visibility="{Binding ProgressVisibility}"/>
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Foreground="{StaticResource Grey}" TextWrapping="Wrap" Margin="2,6,2,0" FontSize="12"
                   Text="NVIDIA drivers install silently. AMD and Intel open their own official installer, which detects your hardware and finishes the job. Drivers are downloaded only from the manufacturer."/>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,12">
      <DockPanel>
        <Button DockPanel.Dock="Right" x:Name="RefreshButton" Content="Check again" Style="{StaticResource GhostButton}" Click="OnRefresh"/>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="Ready"/>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
