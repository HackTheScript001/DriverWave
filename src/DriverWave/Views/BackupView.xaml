<UserControl x:Class="DriverWave.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="24,18,24,8">
      <TextBlock Text="Driver backup" Style="{StaticResource PageTitle}"/>
      <TextBlock Style="{StaticResource PageSub}"
                 Text="Save every driver installed on this PC to a folder or USB stick before reinstalling Windows, then put them all back afterwards in one go – no internet needed."/>
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="24,8,24,6">
      <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,16">
        <DockPanel>
          <Button DockPanel.Dock="Right" x:Name="BackupButton" Content="Back up drivers" Style="{StaticResource PrimaryButton}" Click="OnBackup" VerticalAlignment="Center"/>
          <StackPanel>
            <TextBlock Text="Back up" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock x:Name="DriverCountText" Foreground="{StaticResource Grey}" Margin="0,4,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource Card}" Padding="20,16">
        <DockPanel>
          <Button DockPanel.Dock="Right" x:Name="RestoreButton" Content="Restore drivers" Style="{StaticResource GreenButton}" Click="OnRestore" VerticalAlignment="Center"/>
          <StackPanel>
            <TextBlock Text="Restore" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Foreground="{StaticResource Grey}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Choose a backup folder. Windows installs each driver on any matching hardware and skips the rest, so it's safe to restore a full backup."/>
          </StackPanel>
        </DockPanel>
      </Border>
    </StackPanel>

    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,12">
      <StackPanel>
        <TextBlock x:Name="StatusText" Text="Ready" TextTrimming="CharacterEllipsis"/>
        <ProgressBar x:Name="BusyBar" Style="{StaticResource BusyBarStyle}" Margin="0,8,0,0" IsIndeterminate="True"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
