<Window x:Class="DriverWave.Views.LeftoversWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Leftovers found" Width="820" Height="620" MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="White" FontFamily="Segoe UI" FontSize="13"
        Icon="/Assets/DriverWave.ico" ShowInTaskbar="False">
  <Grid Margin="24,20,24,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock x:Name="HeadText" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
      <TextBlock Foreground="{StaticResource Grey}" Margin="0,4,0,0" TextWrapping="Wrap"
                 Text="These were left behind after the uninstaller finished. Do you want to delete them? Untick anything you want to keep. Registry keys are backed up first and files go to the Recycle Bin."/>
    </StackPanel>

    <!-- Registry -->
    <DockPanel Grid.Row="1" Margin="0,16,0,6">
      <CheckBox x:Name="AllRegistry" DockPanel.Dock="Left" IsChecked="True" Checked="OnAllRegistry" Unchecked="OnAllRegistry" VerticalAlignment="Center"/>
      <TextBlock x:Name="RegistryHead" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
    </DockPanel>
    <DataGrid x:Name="RegistryGrid" Grid.Row="2" RowHeight="34">
      <DataGrid.Columns>
        <DataGridTemplateColumn Width="40" CellTemplate="{StaticResource SelectCell}"/>
        <DataGridTemplateColumn Header="Registry key" Width="*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Item.Display}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Item.Display}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Found as" Binding="{Binding Item.Reason, Mode=OneWay}" Width="150" IsReadOnly="True"/>
      </DataGrid.Columns>
    </DataGrid>

    <!-- Files -->
    <DockPanel Grid.Row="3" Margin="0,14,0,6">
      <CheckBox x:Name="AllFiles" DockPanel.Dock="Left" IsChecked="True" Checked="OnAllFiles" Unchecked="OnAllFiles" VerticalAlignment="Center"/>
      <TextBlock x:Name="FilesHead" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
    </DockPanel>
    <DataGrid x:Name="FileGrid" Grid.Row="4" RowHeight="34">
      <DataGrid.Columns>
        <DataGridTemplateColumn Width="40" CellTemplate="{StaticResource SelectCell}"/>
        <DataGridTemplateColumn Header="File or folder" Width="*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Item.Display}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Item.Display}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Found as" Binding="{Binding Item.Reason, Mode=OneWay}" Width="150" IsReadOnly="True"/>
        <DataGridTextColumn Header="Size" Binding="{Binding SizeText, Mode=OneWay}" Width="90" IsReadOnly="True"/>
      </DataGrid.Columns>
    </DataGrid>

    <DockPanel Grid.Row="5" Margin="0,16,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="No, keep them" Style="{StaticResource GhostButton}" IsCancel="True" Click="OnKeep"/>
        <Button x:Name="DeleteButton" Content="Yes, delete selected" Style="{StaticResource DangerButton}" Click="OnDelete"/>
      </StackPanel>
      <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{StaticResource Grey}"/>
    </DockPanel>
  </Grid>
</Window>
