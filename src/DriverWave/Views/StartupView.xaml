<UserControl x:Class="DriverWave.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="24,18,24,8">
      <TextBlock Text="Startup programs" Style="{StaticResource PageTitle}"/>
      <TextBlock Style="{StaticResource PageSub}"
                 Text="Programs that start with Windows. Turning one off makes the PC start faster and doesn't uninstall anything – you can turn it back on any time. Changes show in Task Manager too."/>
    </StackPanel>

    <DataGrid x:Name="EntryGrid" Grid.Row="1" Margin="24,4,24,6">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="On" Width="56">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" HorizontalAlignment="Center"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Program" Width="1.4*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding Entry.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Entry.Location}" Foreground="{StaticResource Grey}" FontSize="11.5"/>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Runs" Width="3*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Entry.Command}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Entry.Command}" Foreground="{StaticResource Grey}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="130" IsReadOnly="True"/>
      </DataGrid.Columns>
    </DataGrid>

    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Open file location" Style="{StaticResource GhostButton}" Click="OnOpenLocation"/>
          <Button Content="Refresh" Style="{StaticResource GhostButton}" Click="OnRefresh"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="Untick a program to stop it starting with Windows."/>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
