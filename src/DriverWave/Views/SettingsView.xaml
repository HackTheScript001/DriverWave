<UserControl x:Class="DriverWave.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,18,24,18" MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>

      <!-- Updates -->
      <TextBlock Text="UPDATES" Foreground="{StaticResource Grey}" FontSize="11" FontWeight="SemiBold" Margin="0,22,0,8"/>
      <Border Style="{StaticResource Card}" Padding="20,16">
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" x:Name="CheckButton" Content="Check now" Style="{StaticResource GhostButton}" Click="OnCheckNow" VerticalAlignment="Center"/>
            <StackPanel>
              <TextBlock x:Name="VersionLine" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock Text="Updates download in the background and install with one click." Foreground="{StaticResource Grey}" Margin="0,2,0,0"/>
            </StackPanel>
          </DockPanel>
          <CheckBox x:Name="CheckOnStart" Content="Check for updates when DriverWave opens" Margin="0,14,0,0"
                    Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
          <CheckBox x:Name="InstallOnClose" Content="Install a downloaded update when I close DriverWave" Margin="0,8,0,0"
                    Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
        </StackPanel>
      </Border>

      <!-- Files -->
      <TextBlock Text="BACKUPS AND LOGS" Foreground="{StaticResource Grey}" FontSize="11" FontWeight="SemiBold" Margin="0,22,0,8"/>
      <Border Style="{StaticResource Card}" Padding="20,16">
        <StackPanel>
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Grey}"
                     Text="Registry backups from the uninstaller and registry cleaner, and DriverWave's log, are kept in C:\ProgramData\DriverWave."/>
          <StackPanel Orientation="Horizontal" Margin="-8,12,0,0">
            <Button Content="Open backups folder" Style="{StaticResource GhostButton}" Click="OnOpenBackups"/>
            <Button Content="Open log" Style="{StaticResource GhostButton}" Click="OnOpenLog"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- About -->
      <TextBlock Text="ABOUT" Foreground="{StaticResource Grey}" FontSize="11" FontWeight="SemiBold" Margin="0,22,0,8"/>
      <Border Style="{StaticResource Card}" Padding="20,16">
        <StackPanel>
          <TextBlock FontSize="15" FontWeight="SemiBold">
            <Run Text="DriverWave – a "/><Run Text="Second" Foreground="{StaticResource Blue}"/><Run Text="Wave" Foreground="{StaticResource Green}"/><Run Text=" IT Systems product"/>
          </TextBlock>
          <TextBlock Foreground="{StaticResource Grey}" Margin="0,4,0,0" TextWrapping="Wrap"
                     Text="Free to use. © SecondWave IT Systems. All rights reserved. Contact: liam@secondwaveitsystems.cloud"/>
          <StackPanel Orientation="Horizontal" Margin="-8,12,0,0">
            <Button Content="Report a problem" Style="{StaticResource GhostButton}" Click="OnReport"/>
            <Button Content="Licence" Style="{StaticResource GhostButton}" Click="OnLicence"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
