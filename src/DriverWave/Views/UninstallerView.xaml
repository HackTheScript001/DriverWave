<UserControl x:Class="DriverWave.Views.UninstallerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="24,18,24,8">
      <TextBlock Text="Uninstaller" Style="{StaticResource PageTitle}"/>
      <TextBlock Style="{StaticResource PageSub}"
                 Text="Runs a program's own uninstaller, then finds the folders and registry keys it left behind so you can remove them too."/>
    </StackPanel>

    <DockPanel Grid.Row="1" Margin="24,4,24,8">
      <TextBlock x:Name="CountText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource Grey}"/>
      <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="10,0" Width="320" HorizontalAlignment="Left">
        <Grid>
          <TextBox x:Name="SearchBox" BorderThickness="0" VerticalContentAlignment="Center" Height="34" TextChanged="OnSearch"/>
          <TextBlock Text="Search programs…" Foreground="#9CA3AF" VerticalAlignment="Center" IsHitTestVisible="False"
                     x:Name="SearchHint"/>
        </Grid>
      </Border>
    </DockPanel>

    <!-- Program list / leftover list share the same space -->
    <Grid Grid.Row="2" Margin="24,0,24,6">
      <DataGrid x:Name="ProgramGrid" IsReadOnly="True" MouseDoubleClick="OnUninstallDoubleClick">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="Program" Width="2.4*" SortMemberPath="Name">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                  <TextBlock Text="{Binding Publisher}" Foreground="{StaticResource Grey}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Version" Binding="{Binding Version, Mode=OneWay}" Width="*"/>
          <DataGridTextColumn Header="Size" Binding="{Binding SizeText, Mode=OneWay}" Width="90" SortMemberPath="SizeBytes"/>
          <DataGridTextColumn Header="Installed" Binding="{Binding DateText, Mode=OneWay}" Width="100" SortMemberPath="InstallDate"/>
        </DataGrid.Columns>
      </DataGrid>

      <Grid x:Name="LeftoverPanel" Visibility="Collapsed" Background="White">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Background="{StaticResource BlueSoft}" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock x:Name="LeftoverTitle" FontWeight="SemiBold" FontSize="14"/>
            <TextBlock Foreground="{StaticResource Grey}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Untick anything you want to keep. Registry keys are backed up before they're deleted, and files go to the Recycle Bin."/>
          </StackPanel>
        </Border>
        <DataGrid x:Name="LeftoverGrid" Grid.Row="1">
          <DataGrid.Columns>
            <DataGridTemplateColumn Width="44" CellTemplate="{StaticResource SelectCell}"/>
            <DataGridTextColumn Header="Type" Binding="{Binding TypeText, Mode=OneWay}" Width="110" IsReadOnly="True"/>
            <DataGridTemplateColumn Header="Location" Width="3*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Item.Display}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Item.Display}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Found as" Binding="{Binding Item.Reason, Mode=OneWay}" Width="*" IsReadOnly="True"/>
            <DataGridTextColumn Header="Size" Binding="{Binding SizeText, Mode=OneWay}" Width="90" IsReadOnly="True"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Grid>

    <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <!-- Program list buttons -->
          <Button x:Name="RefreshButton" Content="Refresh" Style="{StaticResource GhostButton}" Click="OnRefresh"/>
          <Button x:Name="ForceButton" Content="Remove leftovers only" Style="{StaticResource GhostButton}" Click="OnForce"
                  ToolTip="For programs whose uninstaller is broken or missing"/>
          <Button x:Name="UninstallButton" Content="Uninstall" Style="{StaticResource DangerButton}" Click="OnUninstall"/>
          <!-- Leftover buttons -->
          <Button x:Name="SkipButton" Content="Keep everything" Style="{StaticResource GhostButton}" Click="OnSkipLeftovers" Visibility="Collapsed"/>
          <Button x:Name="RemoveButton" Content="Remove selected" Style="{StaticResource DangerButton}" Click="OnRemoveLeftovers" Visibility="Collapsed"/>
        </StackPanel>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock x:Name="StatusText" Text="Select a program to uninstall." TextTrimming="CharacterEllipsis"/>
          <ProgressBar x:Name="BusyBar" Style="{StaticResource BusyBarStyle}" Margin="0,8,0,0" IsIndeterminate="True"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
