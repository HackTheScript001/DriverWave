<Window x:Class="DriverWave.Views.UninstallConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uninstall" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="White" FontFamily="Segoe UI" FontSize="13"
        Icon="/Assets/DriverWave.ico" ShowInTaskbar="False">
  <StackPanel Margin="24,20,24,18">
    <TextBlock x:Name="HeadText" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
    <TextBlock x:Name="SubText" Foreground="{StaticResource Grey}" Margin="0,4,0,0" TextWrapping="Wrap"/>

    <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{StaticResource Ink}"
               Text="The program's own uninstaller opens first. When it's finished, DriverWave shows you anything it left behind so you can delete that too."/>

    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
      <StackPanel>
        <CheckBox x:Name="BackupBox" IsChecked="True" FontWeight="SemiBold" Content="Make a backup first (System Restore point)"/>
        <TextBlock Foreground="{StaticResource Grey}" TextWrapping="Wrap" Margin="22,4,0,0" FontSize="12"
                   Text="Lets you roll Windows back if something goes wrong. Takes up to a minute. Registry keys DriverWave deletes afterwards are always backed up too."/>
      </StackPanel>
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True" Click="OnCancel"/>
      <Button Content="Uninstall" Style="{StaticResource DangerButton}" IsDefault="True" Click="OnUninstall"/>
    </StackPanel>
  </StackPanel>
</Window>
