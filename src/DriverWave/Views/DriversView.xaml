<UserControl x:Class="DriverWave.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>  <!-- title -->
      <RowDefinition Height="Auto"/>  <!-- offline banner -->
      <RowDefinition Height="Auto"/>  <!-- summary -->
      <RowDefinition Height="*"/>     <!-- results -->
      <RowDefinition Height="Auto"/>  <!-- footer -->
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="24,18,24,8">
      <TextBlock Text="Missing drivers" Style="{StaticResource PageTitle}"/>
      <TextBlock Style="{StaticResource PageSub}" Text="Finds devices with no driver or a basic one, and installs the right driver from Windows Update."/>
    </StackPanel>

    <!-- No internet + bundled network drivers -->
    <Border x:Name="OfflineBanner" Grid.Row="1" Background="#FFF7E6" CornerRadius="8" Padding="16,10" Margin="24,4,24,4" Visibility="Collapsed">
      <DockPanel>
        <Button x:Name="OfflineButton" DockPanel.Dock="Right" Content="Install network drivers" Style="{StaticResource GreenButton}" Click="OnInstallOffline"/>
        <TextBlock x:Name="OfflineBannerText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Ink}"/>
      </DockPanel>
    </Border>

    <!-- Summary -->
    <UniformGrid Grid.Row="2" Rows="1" Margin="18,8,18,6">
      <Border Style="{StaticResource Card}" Margin="6,0">
        <StackPanel>
          <TextBlock Text="Devices scanned" Foreground="{StaticResource Grey}"/>
          <TextBlock x:Name="DevicesCount" Text="–" FontSize="24" FontWeight="SemiBold"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="6,0">
        <StackPanel>
          <TextBlock Text="Missing or basic drivers" Foreground="{StaticResource Grey}"/>
          <TextBlock x:Name="MissingCount" Text="–" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Warn}"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="6,0">
        <StackPanel>
          <TextBlock Text="Drivers found" Foreground="{StaticResource Grey}"/>
          <TextBlock x:Name="FoundCount" Text="–" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Green}"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="6,0">
        <StackPanel>
          <TextBlock Text="Updates for working devices" Foreground="{StaticResource Grey}"/>
          <TextBlock x:Name="UpdatesCount" Text="–" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Blue}"/>
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- Results -->
    <Grid Grid.Row="3" Margin="24,10,24,6">
      <DataGrid x:Name="ResultsGrid" RowHeight="46">
        <DataGrid.Columns>
          <DataGridTemplateColumn Width="44">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                          IsEnabled="{Binding CanInstall}" HorizontalAlignment="Center"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTemplateColumn Header="Device" Width="2*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceId}"/>
                  <TextBlock Text="{Binding Category}" Foreground="{StaticResource Grey}" FontSize="11.5"/>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTextColumn Header="Issue" Binding="{Binding StateText, Mode=OneWay}" Width="130" IsReadOnly="True"/>

          <DataGridTemplateColumn Header="Driver from Windows Update" Width="2*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding DriverTitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DriverTitle}"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTextColumn Header="Size" Binding="{Binding SizeText, Mode=OneWay}" Width="80" IsReadOnly="True"/>

          <DataGridTemplateColumn Header="Status" Width="1.4*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="Installed"><Setter Property="Foreground" Value="#15803D"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="InstalledRebootNeeded"><Setter Property="Foreground" Value="#15803D"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Failed"><Setter Property="Foreground" Value="#B91C1C"/></DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="NoDriverFound"><Setter Property="Foreground" Value="#6B7280"/></DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Downloading"><Setter Property="Foreground" Value="#1E6FD9"/></DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Installing"><Setter Property="Foreground" Value="#1E6FD9"/></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                 Foreground="{StaticResource Grey}" FontSize="15" TextWrapping="Wrap" MaxWidth="460"
                 Text="Scanning will start in a moment…"/>
    </Grid>

    <!-- Footer -->
    <Border Grid.Row="4" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="ScanButton" Content="Scan again" Style="{StaticResource GhostButton}" Click="OnScan"/>
          <Button x:Name="InstallButton" Content="Install selected" Style="{StaticResource PrimaryButton}" Click="OnInstall" IsEnabled="False"/>
        </StackPanel>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
          <DockPanel>
            <CheckBox x:Name="IncludeUpdates" DockPanel.Dock="Right" Content="Include updates for working devices"
                      Foreground="{StaticResource Grey}" Checked="OnIncludeUpdatesChanged" Unchecked="OnIncludeUpdatesChanged"/>
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <ProgressBar x:Name="BusyBar" Style="{StaticResource BusyBarStyle}" Margin="0,8,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
