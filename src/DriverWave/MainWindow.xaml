<Window x:Class="DriverWave.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DriverWave – SecondWave IT Systems" Width="1180" Height="760" MinWidth="960" MinHeight="580"
        WindowStartupLocation="CenterScreen" Background="White"
        Icon="Assets/DriverWave.ico" FontFamily="Segoe UI" FontSize="13"
        Loaded="OnLoaded">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>  <!-- header -->
      <RowDefinition Height="Auto"/>  <!-- app update banner -->
      <RowDefinition Height="*"/>     <!-- sidebar + page -->
      <RowDefinition Height="Auto"/>  <!-- log -->
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,14">
      <DockPanel>
        <!-- SecondWave IT Systems logo + wordmark -->
        <Image Source="Assets/SecondWave.png" Width="56" Height="56" Margin="0,0,10,0" DockPanel.Dock="Left"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
          <TextBlock FontSize="22" FontWeight="Bold" LineHeight="24">
            <Run Text="Second" Foreground="{StaticResource Blue}"/><Run Text="Wave" Foreground="{StaticResource Green}"/>
          </TextBlock>
          <TextBlock Text="I T   S Y S T E M S" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Grey}"/>
        </StackPanel>

        <Border DockPanel.Dock="Left" Width="1" Background="{StaticResource Line}" Margin="22,4"/>

        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
          <TextBlock Text="DriverWave" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
          <TextBlock Text="Drivers, cleanup and maintenance for Windows PCs" Foreground="{StaticResource Grey}"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
          <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource Grey}">
            <Run Text="A "/><Run Text="Second" Foreground="{StaticResource Blue}" FontWeight="SemiBold"/><Run Text="Wave" Foreground="{StaticResource Green}" FontWeight="SemiBold"/><Run Text=" IT Systems product"/>
          </TextBlock>
          <TextBlock x:Name="VersionText" HorizontalAlignment="Right" Foreground="{StaticResource Grey}" FontSize="11.5"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- New version of DriverWave -->
    <Border x:Name="UpdateBanner" Grid.Row="1" Background="{StaticResource BlueSoft}" Padding="24,10" Visibility="Collapsed">
      <DockPanel>
        <Button x:Name="UpdateAppButton" DockPanel.Dock="Right" Content="Update now" Style="{StaticResource PrimaryButton}" Click="OnUpdateApp"/>
        <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center" Foreground="{StaticResource Ink}"/>
      </DockPanel>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="210"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Sidebar -->
      <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="12,16">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="8,0">
            <TextBlock x:Name="UpdateStatus" Foreground="{StaticResource Grey}" FontSize="11.5" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="DRIVERS" Foreground="{StaticResource Grey}" FontSize="11" FontWeight="SemiBold" Margin="12,0,0,6"/>
            <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="drivers" Content="Missing drivers" Checked="OnNav" IsChecked="True"/>
            <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="graphics" Content="Graphics card" Checked="OnNav"/>
            <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="backup" Content="Driver backup" Checked="OnNav"/>

            <TextBlock Text="TOOLS" Foreground="{StaticResource Grey}" FontSize="11" FontWeight="SemiBold" Margin="12,18,0,6"/>
            <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="uninstaller" Content="Uninstaller" Checked="OnNav"/>
            <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="cleanup" Content="System cleanup" Checked="OnNav"/>
            <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="registry" Content="Registry cleaner" Checked="OnNav"/>
            <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="startup" Content="Startup programs" Checked="OnNav"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Current page -->
      <ContentControl x:Name="PageHost" Grid.Column="1"/>
    </Grid>

    <!-- Log -->
    <Expander Grid.Row="3" Header="Details" Margin="16,2,16,4" Foreground="{StaticResource Grey}">
      <TextBox x:Name="LogBox" Height="130" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
               Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"/>
    </Expander>
  </Grid>
</Window>
