<Window x:Class="DriverWave.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DriverWave" Width="1040" Height="700" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="White"
        Icon="Assets/DriverWave.ico" FontFamily="Segoe UI" FontSize="13"
        Loaded="OnLoaded">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>  <!-- header -->
      <RowDefinition Height="Auto"/>  <!-- app update banner -->
      <RowDefinition Height="Auto"/>  <!-- offline network banner -->
      <RowDefinition Height="Auto"/>  <!-- summary -->
      <RowDefinition Height="*"/>     <!-- results -->
      <RowDefinition Height="Auto"/>  <!-- log -->
      <RowDefinition Height="Auto"/>  <!-- footer -->
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,16">
      <DockPanel>
        <Image Source="Assets/DriverWave.png" Width="40" Height="40" Margin="0,0,12,0" DockPanel.Dock="Left"/>
        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
          <TextBlock FontSize="22" FontWeight="Bold">
            <Run Text="Driver" Foreground="{StaticResource Blue}"/><Run Text="Wave" Foreground="{StaticResource Green}"/>
          </TextBlock>
          <TextBlock Text="Finds and installs missing drivers from Windows Update" Foreground="{StaticResource Grey}"/>
        </StackPanel>
        <TextBlock x:Name="VersionText" DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right"
                   Foreground="{StaticResource Grey}"/>
      </DockPanel>
    </Border>

    <!-- New version of DriverWave -->
    <Border x:Name="UpdateBanner" Grid.Row="1" Background="#EAF2FD" Padding="24,10" Visibility="Collapsed">
      <DockPanel>
        <Button x:Name="UpdateAppButton" DockPanel.Dock="Right" Content="Update now" Style="{StaticResource PrimaryButton}" Click="OnUpdateApp"/>
        <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center" Foreground="{StaticResource Ink}"/>
      </DockPanel>
    </Border>

    <!-- No internet + bundled network drivers -->
    <Border x:Name="OfflineBanner" Grid.Row="2" Background="#FFF7E6" Padding="24,10" Visibility="Collapsed">
      <DockPanel>
        <Button x:Name="OfflineButton" DockPanel.Dock="Right" Content="Install network drivers" Style="{StaticResource GreenButton}" Click="OnInstallOffline"/>
        <TextBlock x:Name="OfflineBannerText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Ink}"/>
      </DockPanel>
    </Border>

    <!-- Summary -->
    <UniformGrid Grid.Row="3" Rows="1" Margin="18,16,18,6">
      <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="16,12" Margin="6,0">
        <StackPanel>
          <TextBlock Text="Devices scanned" Foreground="{StaticResource Grey}"/>
          <TextBlock x:Name="DevicesCount" Text="–" FontSize="26" FontWeight="SemiBold"/>
        </StackPanel>
      </Border>
      <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="16,12" Margin="6,0">
        <StackPanel>
          <TextBlock Text="Missing or basic drivers" Foreground="{StaticResource Grey}"/>
          <TextBlock x:Name="MissingCount" Text="–" FontSize="26" FontWeight="SemiBold" Foreground="#C2410C"/>
        </StackPanel>
      </Border>
      <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="16,12" Margin="6,0">
        <StackPanel>
          <TextBlock Text="Drivers found" Foreground="{StaticResource Grey}"/>
          <TextBlock x:Name="FoundCount" Text="–" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Green}"/>
        </StackPanel>
      </Border>
      <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="16,12" Margin="6,0">
        <StackPanel>
          <TextBlock Text="Updates for working devices" Foreground="{StaticResource Grey}"/>
          <TextBlock x:Name="UpdatesCount" Text="–" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Blue}"/>
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- Results -->
    <Grid Grid.Row="4" Margin="24,10,24,6">
      <DataGrid x:Name="ResultsGrid"AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource Line}"
                BorderBrush="{StaticResource Line}" BorderThickness="1" Background="White" RowBackground="White"
                SelectionMode="Single" SelectionUnit="FullRow" IsReadOnly="False" RowHeight="46"
                ColumnHeaderHeight="34" VerticalScrollBarVisibility="Auto">
        <DataGrid.ColumnHeaderStyle>
          <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="Foreground" Value="{StaticResource Grey}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
          </Style>
        </DataGrid.ColumnHeaderStyle>
        <DataGrid.CellStyle>
          <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                  <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                    <ContentPresenter VerticalAlignment="Center"/>
                  </Border>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </DataGrid.CellStyle>

        <DataGrid.Columns>
          <DataGridTemplateColumn Width="44">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                          IsEnabled="{Binding CanInstall}" HorizontalAlignment="Center"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTemplateColumn Header="Device" Width="2*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceId}"/>
                  <TextBlock Text="{Binding Category}" Foreground="{StaticResource Grey}" FontSize="11.5"/>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTextColumn Header="Issue" Binding="{Binding StateText, Mode=OneWay}" Width="130" IsReadOnly="True"/>

          <DataGridTemplateColumn Header="Driver from Windows Update" Width="2*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding DriverTitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DriverTitle}"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTextColumn Header="Size" Binding="{Binding SizeText, Mode=OneWay}" Width="80" IsReadOnly="True"/>

          <DataGridTemplateColumn Header="Status" Width="1.4*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="Installed"><Setter Property="Foreground" Value="#15803D"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="InstalledRebootNeeded"><Setter Property="Foreground" Value="#15803D"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Failed"><Setter Property="Foreground" Value="#B91C1C"/></DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="NoDriverFound"><Setter Property="Foreground" Value="#6B7280"/></DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Downloading"><Setter Property="Foreground" Value="#1E6FD9"/></DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Installing"><Setter Property="Foreground" Value="#1E6FD9"/></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <!-- Shown when there's nothing in the grid -->
      <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                 Foreground="{StaticResource Grey}" FontSize="15" TextWrapping="Wrap" MaxWidth="460"
                 Text="Scanning will start in a moment…"/>
    </Grid>

    <!-- Log -->
    <Expander Grid.Row="5" Header="Details" Margin="24,0,24,4" Foreground="{StaticResource Grey}">
      <TextBox x:Name="LogBox" Height="130" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
               Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"/>
    </Expander>

    <!-- Footer -->
    <Border Grid.Row="6" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,14">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="ScanButton" Content="Scan again" Style="{StaticResource GhostButton}" Click="OnScan"/>
          <Button x:Name="InstallButton" Content="Install selected" Style="{StaticResource PrimaryButton}" Click="OnInstall" IsEnabled="False"/>
        </StackPanel>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
          <DockPanel>
            <CheckBox x:Name="IncludeUpdates" DockPanel.Dock="Right" Content="Include updates for working devices"
                      Foreground="{StaticResource Grey}" Checked="OnIncludeUpdatesChanged" Unchecked="OnIncludeUpdatesChanged"/>
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <ProgressBar x:Name="BusyBar" Height="6" Margin="0,8,0,0" Foreground="{StaticResource Blue}"
                       Background="{StaticResource Line}" BorderThickness="0" Visibility="Hidden"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
