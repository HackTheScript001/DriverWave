<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>DriverWave</AssemblyName>
    <RootNamespace>DriverWave</RootNamespace>
    <Product>DriverWave</Product>
    <Company>SecondWave IT Systems</Company>
    <Authors>Liam Mayes</Authors>
    <Description>Finds and installs missing Windows drivers after a fresh install.</Description>
    <Copyright>© SecondWave IT Systems. DriverWave is a SecondWave IT Systems product.</Copyright>

    <!-- To release an update: bump this, add a "What's new in x.y.z" section to RELEASE_NOTES.md, push -->
    <Version>1.1.3</Version>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DriverWave.ico</ApplicationIcon>

    <!-- Fresh Windows installs have no .NET runtime, so ship it inside the exe -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\DriverWave.ico" />
    <Resource Include="Assets\DriverWaveLogo.png" />
  </ItemGroup>

</Project>
